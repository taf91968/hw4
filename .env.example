# Copy this file to .env (in hw4/ or hw4/backend/) and fill in your own values.
# Never commit or share .env. Placeholders only -- no real secrets here.

# Required: Portkey API key used for every model call made by the PydanticAI agent.
PORTKEY_API_KEY=your_portkey_api_key_here

# Model routed through Portkey (default: gpt-5.6-luna).
OPENAI_MODEL=gpt-5.6-luna

# Recommended: signs the login session cookie. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is made at startup and everyone is logged out on restart.
SESSION_SECRET=replace_with_a_long_random_string

# Optional: hide the PydanticAI startup banner.
PYDANTIC_AI_NO_BANNER=1

# Optional (testing): use a copy of the database / a different audit-trail file.
# CC_DB_PATH=C:/path/to/campus_customs_copy.db
# CC_AUDIT_PATH=C:/path/to/audit_trail_test.json
